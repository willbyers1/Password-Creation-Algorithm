    "bcryptjs": "3.0.3",
    "hash-wasm": "4.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "scrypt-js": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vite": "5.4.21",
